<%- include('partials/header') %>

<section class="hero-section">
  <h1 class="glitch" data-text="嗨，我是小火">嗨，我是小火</h1>
  <p>歡迎來到我的個人作品集。這裡收錄我的設計與開發作品，以及一些創作心得與筆記。</p>
  <div style="margin-top: 20px;">
    <a class="btn" href="/portfolio">查看作品集</a>
    <a class="btn btn-secondary" href="/about">關於我</a>
  </div>
</section>

<h2 class="page-title">精選作品</h2>
<div class="grid grid-3">
  <% portfolioPreview.forEach(p => { %>
    <div class="card">
      <h3><%= p.title %></h3>
      <p style="color: var(--muted);"><%= p.description %></p>
    </div>
  <% }) %>
  <% if (portfolioPreview.length === 0) { %><p style="color: var(--muted);">尚無作品。</p><% } %>
</div>

<h2 class="page-title">最新文章</h2>
<div class="grid grid-3">
  <% latestArticles.forEach(a => { %>
    <div class="card">
      <h3><a href="/articles/<%= a.id %>" style="color: var(--dynamic); text-decoration: none;"><%= a.title %></a></h3>
      <p style="color: var(--muted);"><%= a.summary %></p>
    </div>
  <% }) %>
  <% if (latestArticles.length === 0) { %><p style="color: var(--muted);">尚無文章。</p><% } %>
</div>

<%- include('partials/footer') %>
