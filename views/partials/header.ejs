<!DOCTYPE html>
<html lang="zh-Hant">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %> | 小火的作品集</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Orbitron:wght@500;700;900&family=Rajdhani:wght@500;600;700&display=swap" />
  <link rel="stylesheet" href="/css/style.css?v=5" />
</head>
<body>
  <div class="bg-hero">
    <div class="bg-city">
      <svg viewBox="0 0 1200 180" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
        <g fill="#060410">
          <rect x="0" y="90" width="70" height="90"/><rect x="70" y="50" width="40" height="130"/>
          <rect x="110" y="110" width="55" height="70"/><rect x="165" y="30" width="45" height="150"/>
          <rect x="210" y="80" width="60" height="100"/><rect x="270" y="60" width="35" height="120"/>
          <rect x="305" y="20" width="50" height="160"/><rect x="355" y="100" width="65" height="80"/>
          <rect x="420" y="40" width="40" height="140"/><rect x="460" y="70" width="55" height="110"/>
          <rect x="515" y="10" width="45" height="170"/><rect x="560" y="85" width="70" height="95"/>
          <rect x="630" y="45" width="40" height="135"/><rect x="670" y="65" width="60" height="115"/>
          <rect x="730" y="25" width="50" height="155"/><rect x="780" y="95" width="45" height="85"/>
          <rect x="825" y="55" width="65" height="125"/><rect x="890" y="35" width="40" height="145"/>
          <rect x="930" y="80" width="55" height="100"/><rect x="985" y="15" width="48" height="165"/>
          <rect x="1033" y="90" width="60" height="90"/><rect x="1093" y="40" width="45" height="140"/>
          <rect x="1138" y="70" width="62" height="110"/>
        </g>
        <g fill="#2dfcdc" opacity="0.55">
          <rect x="80" y="70" width="4" height="6"/><rect x="92" y="90" width="4" height="6"/>
          <rect x="175" y="55" width="4" height="6"/><rect x="320" y="45" width="4" height="6"/>
          <rect x="336" y="75" width="4" height="6"/><rect x="525" y="35" width="4" height="6"/>
          <rect x="740" y="55" width="4" height="6"/><rect x="995" y="45" width="4" height="6"/>
          <rect x="1008" y="80" width="4" height="6"/>
        </g>
        <g fill="#ff2bd6" opacity="0.55">
          <rect x="230" y="100" width="4" height="6"/><rect x="430" y="65" width="4" height="6"/>
          <rect x="645" y="70" width="4" height="6"/><rect x="845" y="80" width="4" height="6"/>
          <rect x="900" y="60" width="4" height="6"/><rect x="1105" y="65" width="4" height="6"/>
        </g>
      </svg>
    </div>
    <div class="bg-overlay"></div>
    <div class="bg-glow glow-1"></div>
    <div class="bg-glow glow-2"></div>
    <div class="bg-glow glow-3"></div>
  </div>
  <div class="cursor-glow" id="cursorGlow"></div>

  <header class="site-header">
    <div class="container header-inner">
      <a class="brand" href="/">小火的作品集</a>
      <button class="nav-toggle" id="navToggle" aria-label="開啟選單">☰</button>
      <nav class="main-nav" id="mainNav">
        <a href="/">首頁</a>
        <a href="/about">關於我</a>
        <a href="/portfolio">作品集</a>
        <a href="/articles">文章列表</a>
        <% if (currentUser) { %>
          <% if (currentUser.role === 'admin') { %>
            <a href="/admin">後台管理</a>
          <% } %>
          <span class="nav-user">你好，<%= currentUser.username %></span>
          <form action="/logout" method="POST" class="inline-form">
            <button type="submit" class="link-btn">登出</button>
          </form>
        <% } else { %>
          <a href="/login">登入</a>
          <a href="/register">註冊</a>
        <% } %>
      </nav>
    </div>
  </header>

  <main class="container page-content">
